# ==============================================================================
# AVY — Streaming Live RAG Assistant (Environment Configuration)
# Samsung PRISM GenAI Hackathon — Theme 04
# ==============================================================================

# LLM Provider Configuration ("ollama", "openai", "mock")
AVY_PROVIDER=ollama
AVY_MODEL=qwen3:4b
AVY_OLLAMA_HOST=http://127.0.0.1:11434
AVY_TEMPERATURE=0.1
AVY_TIMEOUT=30.0

# Optional OpenAI-compatible Endpoint (used if AVY_PROVIDER=openai)
AVY_API_KEY=
AVY_BASE_URL=https://api.openai.com/v1

# Embedding Configuration ("fastembed", "local_dense", "openai")
# "fastembed" uses ONNX BAAI/bge-small-en-v1.5 (lightweight, local, CPU-friendly)
# "local_dense" uses pure Python/NumPy subword dense vectors (zero external download, works offline)
AVY_EMBEDDING_PROVIDER=fastembed
AVY_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# Reranker Configuration ("fastembed", "lexical", "none")
AVY_RERANKER_ENABLED=true
AVY_RERANKER_MODEL=BAAI/bge-reranker-base

# Vector Store & Search Parameters
AVY_CORPUS_DIR=corpus
AVY_INDEX_PATH=data/index/avy_faiss.index
AVY_METADATA_PATH=data/index/avy_metadata.json
AVY_TOP_K=5
AVY_RRF_K=60
AVY_SIMILARITY_THRESHOLD=0.30

# Retrieval Controller Settings
# States: WAIT, RETRIEVE, NO_RETRIEVE
AVY_CONTROLLER_MODE=hybrid
AVY_WAIT_TOKEN_MIN=3

# Telemetry
AVY_TELEMETRY_ENABLED=true
AVY_TELEMETRY_LOG=data/telemetry/events.jsonl

# Web Demo UI & Server
AVY_SERVER_HOST=127.0.0.1
AVY_SERVER_PORT=8000
